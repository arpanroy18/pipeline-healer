# Target Repository
TARGET_REPO_OWNER=arpanroy18
TARGET_REPO_NAME=pipeline-healer

# -------------------------------------------------------------
# AUTHENTICATION: Choose Option A OR Option B
# -------------------------------------------------------------

# OPTION A: Personal Access Token (PAT)
# Simplest for single-repo & enterprise (requires repo & workflow scopes)
# GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# OPTION B: GitHub App (no webhook needed in polling mode)
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY_PATH=./github_app_private_key.pem
# GITHUB_WEBHOOK_SECRET=your_webhook_secret (only if webhook is enabled)

# Server Port & Host (only if running FastAPI webhook server)
PORT=8000
HOST=0.0.0.0
